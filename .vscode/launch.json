{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RCMPSP: Baselines on all 2-project j30 instances",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.baselines",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--seed",
                "17",
                "--exact-time-limit",
                "60",
                "--output-csv",
                "outputs/baselines_j30_a2/makespan_summary.csv"
            ]
        },
        {
            "name": "RCMPSP: Train SB3 PPO-GNN (multi-instance)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.train_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--n-envs",
                "64",
                "--total-timesteps",
                "100000",
                "--batch-size",
                "256",
                "--n-steps",
                "512",
                "--n-epochs",
                "4",
                "--device",
                "auto",
                "--torch-threads",
                "1",
                "--seed",
                "17",
                "--output-dir",
                "outputs/ppo_gnn_launch"
            ]
        },
        {
            "name": "RCMPSP: Evaluate PPO on all 2-project j30 instances",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.train_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--evaluate-only",
                "--device",
                "auto",
                "--torch-threads",
                "1",
                "--seed",
                "17",
                "--exact-time-limit",
                "60",
                "--output-dir",
                "outputs/ppo_gnn_launch"
            ]
        }
    ]
}
