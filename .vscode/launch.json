{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RCMPSP: Baselines on MPLIB2 10/500/5 (5 instances)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.baselines",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--instances-root",
                "data/MPLIB2_train_10_500_5",
                "--seed",
                "17",
                "--max-instances",
                "5",
                "--exact-time-limit",
                "60",
                "--output-csv",
                "outputs/baselines_mplib2_10_500_5/makespan_summary.csv"
            ]
        },
        {
            "name": "RCMPSP: Train PPO-GIN on MPLIB2 10/500/5 (A800)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.train_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--instances-root",
                "data/MPLIB2_train_10_500_5",
                "--n-envs",
                "96",
                "--total-timesteps",
                "6400000",
                "--batch-size",
                "8192",
                "--n-steps",
                "256",
                "--n-epochs",
                "2",
                "--gin-layers",
                "2",
                "--device",
                "cuda:0",
                "--mixed-precision",
                "bf16",
                "--cuda-matmul-precision",
                "high",
                "--torch-compile",
                "--compile-mode",
                "reduce-overhead",
                "--vec-env",
                "subproc",
                "--start-method",
                "spawn",
                "--torch-threads",
                "1",
                "--torch-interop-threads",
                "1",
                "--seed",
                "17",
                "--splits",
                "outputs/ppo_gin_a800/splits.json",
                "--eval-max-instances",
                "5",
                "--exact-time-limit",
                "60",
                "--exact-workers",
                "1",
                "--output-dir",
                "outputs/ppo_gin_a800"
            ]
        },
        {
            "name": "RCMPSP: Ablate GIN layers and PPO epochs on MPLIB2 10/500/5",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.ablate_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--instances-root",
                "data/MPLIB2_train_10_500_5",
                "--gin-layers",
                "2",
                "3",
                "--ppo-epochs",
                "2",
                "4",
                "--n-envs",
                "96",
                "--n-steps",
                "256",
                "--batch-size",
                "1024",
                "--total-timesteps",
                "6400000",
                "--eval-freq",
                "100000",
                "--eval-split",
                "train",
                "--eval-max-instances",
                "5",
                "--device",
                "cpu",
                "--torch-threads",
                "8",
                "--torch-interop-threads",
                "1",
                "--seeds",
                "17",
                "--output-dir",
                "outputs/ppo_ablation",
                "--splits",
                "outputs/ppo_ablation/splits.json"
            ]
        },
        {
            "name": "RCMPSP: Evaluate PPO-GIN on MPLIB2 10/500/5 (5 instances)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.train_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--instances-root",
                "data/MPLIB2_train_10_500_5",
                "--evaluate-only",
                "--eval-max-instances",
                "5",
                "--device",
                "auto",
                "--torch-threads",
                "1",
                "--torch-interop-threads",
                "1",
                "--seed",
                "17",
                "--exact-time-limit",
                "60",
                "--exact-workers",
                "1",
                "--splits",
                "outputs/ppo_gin_a800/splits.json",
                "--output-dir",
                "outputs/ppo_gin_a800"
            ]
        }
    ]
}
