{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RCMPSP: Baselines on all 2-project j30 instances",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.baselines",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--seed",
                "17",
                "--exact-time-limit",
                "60",
                "--output-csv",
                "outputs/baselines_j30_a2/makespan_summary.csv"
            ]
        },
        {
            "name": "RCMPSP: Train PPO-GIN (multi-instance)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.train_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--n-envs",
                "96",
                "--total-timesteps",
                "6400000",
                "--batch-size",
                "1024",
                "--n-steps",
                "256",
                "--n-epochs",
                "2",
                "--gin-layers",
                "2",
                "--device",
                "cpu",
                "--torch-threads",
                "8",
                "--torch-interop-threads",
                "1",
                "--seed",
                "17",
                "--splits",
                "outputs/ppo_gin_launch/splits.json",
                "--exact-time-limit",
                "60",
                "--exact-workers",
                "1",
                "--output-dir",
                "outputs/ppo_gin_launch"
            ]
        },
        {
            "name": "RCMPSP: Ablate GIN layers and PPO epochs",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.ablate_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--gin-layers",
                "2",
                "3",
                "--ppo-epochs",
                "2",
                "4",
                "--n-envs",
                "96",
                "--n-steps",
                "256",
                "--batch-size",
                "1024",
                "--total-timesteps",
                "6400000",
                "--eval-freq",
                "100000",
                "--eval-split",
                "train",
                "--device",
                "cpu",
                "--torch-threads",
                "8",
                "--torch-interop-threads",
                "1",
                "--seeds",
                "17",
                "--output-dir",
                "outputs/ppo_ablation",
                "--splits",
                "outputs/ppo_ablation/splits.json"
            ]
        },
        {
            "name": "RCMPSP: Evaluate PPO-GIN on all 2-project j30 instances",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.train_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--evaluate-only",
                "--device",
                "auto",
                "--torch-threads",
                "1",
                "--torch-interop-threads",
                "1",
                "--seed",
                "17",
                "--exact-time-limit",
                "60",
                "--exact-workers",
                "1",
                "--splits",
                "outputs/ppo_gin_launch/splits.json",
                "--output-dir",
                "outputs/ppo_gin_launch"
            ]
        }
    ]
}
